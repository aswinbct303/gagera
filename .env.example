# Copy this file to .env or config.env and replace every placeholder.
# Never commit real credentials.
MONGODB_URI=mongodb://localhost:27017/gagera
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=2749
ALWAYS_ONLINE=false
AUTO_STATUS_VIEW=true
BOT_INFO=Gagera;Your Name;https://example.com/media.mp4
CALL_BLOCK=false
DISABLE_PM=false
HANDLERS=false
LANGUAGE=english
LOGS=false
MENU_TYPE=video
READ_MESSAGES=false
REJECT_CALL=false
SAVE_STATUS=false
START_MSG=true
STATUS_REPLY=false
STATUS_REACTION=false
SUDO=<international-number>
WORK_TYPE=public
